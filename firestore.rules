rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId) && isValidId(userId) && request.resource.data.userId == request.auth.uid;
      allow delete: if false;

      // Subcollection: Chapter Progress
      match /chapters/{chapterId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(chapterId) && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }

      // Subcollection: Daily Plans
      match /daily_plans/{planDate} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(planDate) && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }

      // Subcollection: Mock Test Results
      match /mock_results/{resultId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(resultId) && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }
    }
  }
}
